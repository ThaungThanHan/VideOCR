[Unit]
Description=VideOCR local worker placeholder
After=network.target

[Service]
Type=simple
User=videocr
Group=videocr
EnvironmentFile=-/etc/videocr-worker.env
WorkingDirectory=/opt/videocr
ExecStart=/opt/videocr/.venv/bin/python -m server_cli --help
Restart=no
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/subextractor
MemoryMax=2500M
TasksMax=64
Nice=5

[Install]
WantedBy=multi-user.target
